# ReplyPilot is a static app. Nothing in this file is secret, and you should NEVER
# put an API key here: anything prefixed PUBLIC_ is bundled into the browser.
# Users paste their own key in Settings; it is stored only in their browser.

# Optional defaults shown in the Settings panel
PUBLIC_DEFAULT_BASE_URL=https://api.openai.com/v1
PUBLIC_DEFAULT_MODEL=gpt-4o-mini
PUBLIC_BUSINESS_NAME=

# Only needed when hosting under a sub-path or a custom URL; leave empty for local development
BASE_PATH=
SITE_URL=
